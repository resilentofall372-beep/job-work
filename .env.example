# --- Login ---
# Your dashboard password. (Or set APP_PASSWORD_HASH_B64 instead, from `npm run hash-password -- "yourpassword"`.)
APP_PASSWORD=
# Any long random string (40+ characters). Signs your login cookie.
AUTH_SECRET=

# --- Database (added automatically when you connect Neon in Vercel) ---
DATABASE_URL=

# --- Daily refresh ---
# Any long random string. Vercel uses it to call the daily refresh.
CRON_SECRET=

# --- Gmail (read-only access to your job alert emails) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
